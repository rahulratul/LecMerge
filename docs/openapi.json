      "LectureCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Lecture 4: Design Patterns"
            ]
          },
          "lecture_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Lecture Date",
            "examples": [
              "2026-11-28"
            ]
          },
          "block_topics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Block Topics",
            "examples": [
              [
                "Composite Pattern",
                "Strategy Pattern",
                "Builder Pattern"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "LectureCreate"
      },
      "LectureOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "course_id": {
            "type": "integer",
            "title": "Course Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "lecture_date": {
            "anyOf": [
