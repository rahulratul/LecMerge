            "title": "Course Code"
          },
          "course_title": {
            "type": "string",
            "title": "Course Title"
          },
          "total_blocks": {
            "type": "integer",
            "title": "Total Blocks"
          },
          "covered_blocks": {
            "type": "integer",
            "title": "Covered Blocks"
          },
          "coverage_percent": {
            "type": "number",
            "title": "Coverage Percent"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "markdown": {
            "type": "string",
            "title": "Markdown"
          }
        },
        "type": "object",
        "required": [
          "lecture_id",
          "lecture_title",
          "course_code",
          "course_title",
          "total_blocks",
          "covered_blocks",
          "coverage_percent",
          "warnings",
          "filename",
          "markdown"
        ],
