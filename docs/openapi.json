            "title": "Order Index"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "merged_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merged Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "lecture_id",
          "order_index",
          "topic",
          "created_at"
        ],
        "title": "AnchorBlockOut"
      },
      "BlockAnalysisOut": {
        "properties": {
