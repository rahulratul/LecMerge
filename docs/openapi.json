              "Course 99 not found."
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "FragmentCreate": {
        "properties": {
          "author_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Author Name",
            "examples": [
              "Amina"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content",
            "examples": [
              "F = ma\nApplies to constant mass systems."
            ]
          }
        },
        "type": "object",
        "required": [
          "author_name",
          "content"
        ],
        "title": "FragmentCreate"
      },
      "FragmentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "block_id": {
            "type": "integer",
            "title": "Block Id"
          },
          "author_name": {
            "type": "string",
