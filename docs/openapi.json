          },
          "conflict_lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Conflict Lines"
          }
        },
        "type": "object",
        "required": [
          "block_id",
          "strategy_key",
          "strategy_label",
          "selected_fragment_id",
          "selected_author",
          "merged_content",
          "fragment_count",
          "has_potential_conflict",
          "conflict_lines"
        ],
        "title": "MergeResponse"
      },
      "StudySheetOut": {
        "properties": {
