{
  "openapi": "3.1.0",
  "info": {
    "title": "LecMerge API",
    "description": "Collaborative Lecture Note Organizer and Study-Sheet Compiler. Exposes the same application service layer used by the server-rendered GUI.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/courses": {
      "get": {
        "tags": [
          "Courses"
        ],
        "summary": "List all courses",
        "description": "Return all stored courses ordered by course code.",
        "operationId": "list_courses_api_v1_courses_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CourseOut"
                  },
                  "type": "array",
                  "title": "Response List Courses Api V1 Courses Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Courses"
        ],
        "summary": "Create a course",
        "description": "Create a new course with a unique course code and title.",
        "operationId": "create_course_api_v1_courses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CourseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation or duplicate course code error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses/{course_id}/lectures": {
      "post": {
        "tags": [
          "Lectures"
        ],
        "summary": "Create a lecture with ordered anchor blocks",
        "description": "Create a lecture under an existing course together with its initial ordered topic blocks.",
        "operationId": "create_lecture_api_v1_courses__course_id__lectures_post",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Course Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LectureCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LectureOut"
                }
              }
            }
          },
          "404": {
            "description": "Course not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/blocks/{block_id}/fragments": {
      "post": {
        "tags": [
          "Fragments & Merge"
        ],
        "summary": "Submit a note fragment",
        "description": "Attach a contributor's text fragment to an anchor block without overwriting existing fragments.",
        "operationId": "submit_fragment_api_v1_blocks__block_id__fragments_post",
        "parameters": [
          {
            "name": "block_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Block Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FragmentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FragmentOut"
                }
              }
            }
          },
          "404": {
            "description": "Anchor block not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lectures/{lecture_id}/analysis": {
      "get": {
        "tags": [
          "Analysis & Export"
        ],
        "summary": "Analyze lecture coverage, blind spots, and potential conflicts",
        "description": "Compute coverage via the Composite hierarchy and flag potential formula conflicts per block.",
        "operationId": "analyze_lecture_api_v1_lectures__lecture_id__analysis_get",
        "parameters": [
          {
            "name": "lecture_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Lecture Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LectureAnalysisOut"
                }
              }
            }
          },
          "404": {
            "description": "Lecture not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/blocks/{block_id}/merge": {
      "post": {
        "tags": [
          "Fragments & Merge"
        ],
        "summary": "Merge a block using a selected strategy",
        "description": "Select one canonical fragment using the requested strategy and persist it while keeping all fragments.",
        "operationId": "merge_block_api_v1_blocks__block_id__merge_post",
        "parameters": [
          {
            "name": "block_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Block Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Anchor block not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Block has no fragments or invalid strategy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lectures/{lecture_id}/study-sheet": {
      "get": {
        "tags": [
          "Analysis & Export"
        ],
        "summary": "Generate or download a Markdown study sheet",
        "description": "Compile the lecture into Markdown via StudySheetBuilder. Pass download=true to receive a .md attachment.",
        "operationId": "get_study_sheet_api_v1_lectures__lecture_id__study_sheet_get",
        "parameters": [
          {
            "name": "lecture_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Lecture Id"
            }
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Return raw Markdown as a downloadable .md file.",
              "default": false,
              "title": "Download"
            },
            "description": "Return raw Markdown as a downloadable .md file."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudySheetOut"
                }
              }
            }
          },
          "404": {
            "description": "Lecture not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
