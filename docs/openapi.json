          "order_index": {
            "type": "integer",
            "title": "Order Index"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "fragment_count": {
            "type": "integer",
            "title": "Fragment Count"
          },
          "has_merged_content": {
            "type": "boolean",
            "title": "Has Merged Content"
          },
          "merged_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merged Content"
          },
          "is_blind_spot": {
            "type": "boolean",
            "title": "Is Blind Spot"
          },
          "has_potential_conflict": {
            "type": "boolean",
            "title": "Has Potential Conflict"
          },
          "conflict_lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
