          }
        },
        "type": "object",
        "required": [
          "id",
          "block_id",
          "author_name",
          "content",
          "created_at"
        ],
        "title": "FragmentOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LectureAnalysisOut": {
