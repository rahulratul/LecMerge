        "type": "object",
        "required": [
          "id",
          "course_id",
          "title",
          "created_at"
        ],
        "title": "LectureOut"
      },
      "MergeRequest": {
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "most_detailed",
              "latest_submitted"
            ],
            "title": "Strategy",
            "description": "Merge strategy key used to select one canonical fragment.",
            "default": "most_detailed",
            "examples": [
              "most_detailed"
            ]
          }
        },
        "type": "object",
        "title": "MergeRequest"
      },
      "MergeResponse": {
        "properties": {
          "block_id": {
            "type": "integer",
            "title": "Block Id"
          },
          "strategy_key": {
            "type": "string",
            "title": "Strategy Key"
          },
          "strategy_label": {
            "type": "string",
            "title": "Strategy Label"
          },
          "selected_fragment_id": {
            "type": "integer",
            "title": "Selected Fragment Id"
          },
          "selected_author": {
