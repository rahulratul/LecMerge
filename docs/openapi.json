      },
      "CourseCreate": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Code",
            "examples": [
              "CSE 3206"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Software Engineering Sessional"
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "title"
        ],
        "title": "CourseCreate"
      },
      "CourseOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "created_at"
        ],
        "title": "CourseOut"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
