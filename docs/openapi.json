            "title": "Lecture Title"
          },
          "course_id": {
            "type": "integer",
            "title": "Course Id"
          },
          "course_code": {
            "type": "string",
            "title": "Course Code"
          },
          "course_title": {
            "type": "string",
            "title": "Course Title"
          },
          "total_blocks": {
            "type": "integer",
            "title": "Total Blocks"
          },
          "covered_blocks": {
            "type": "integer",
            "title": "Covered Blocks"
          },
          "coverage_percent": {
            "type": "number",
            "title": "Coverage Percent"
          },
          "blind_spot_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Blind Spot Ids"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/BlockAnalysisOut"
            },
            "type": "array",
            "title": "Blocks"
